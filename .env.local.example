# Salin file ini jadi ".env.local" (tanpa .example) lalu isi dengan nilai dari
# Supabase dashboard Anda: Settings -> API.
#
# PENTING: hanya isi anon/public key di sini. JANGAN PERNAH menaruh
# service_role key di file ini atau di kode manapun yang ikut ke GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_public_key_di_sini
